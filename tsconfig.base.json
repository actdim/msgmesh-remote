{
    "extends": ["@actdim/dev-config/tsconfig/base.json", "@actdim/dev-config/tsconfig/loose.json"],
    "compilerOptions": {
        "declaration": false,
        "declarationMap": false,
        "emitDeclarationOnly": false,
        "sourceMap": false,
        "inlineSources": false,
        "inlineSourceMap": false,
        "allowImportingTsExtensions": true,
        "traceResolution": false,
        "removeComments": true,
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": [],
        "allowUmdGlobalAccess": true,
        "incremental": true,
        "noEmit": true,
        "noEmitOnError": true,
        "rootDir": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "composite": true,
        "importHelpers": true
    }
}
