{
    "name": "@actdim/msgmesh-remote",
    "version": "1.12.0",
    "description": "Bidirectional remote transport, WebSocket bridge, and reconnect orchestration for @actdim/msgmesh.",
    "author": "Pavel Borodaev",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/actdim/msgmesh-remote.git"
    },
    "bugs": {
        "url": "https://github.com/actdim/msgmesh-remote/issues"
    },
    "homepage": "https://github.com/actdim/msgmesh-remote/#readme",
    "keywords": [
        "typescript",
        "msgmesh",
        "message-bus",
        "websocket",
        "transport",
        "realtime",
        "rpc",
        "pubsub",
        "remote-bridge",
        "webview",
        "full-duplex"
    ],
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.es.js"
        },
        "./client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.es.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.es.js"
        },
        "./protocol": {
            "types": "./dist/protocol.d.ts",
            "import": "./dist/protocol.es.js"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.es.js"
        }
    },
    "typesVersions": {
        "*": {
            "*": [
                "dist/*.d.ts"
            ]
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "scripts": {
        "test": "npx vitest --config=vitest.node.config.ts --no-cache",
        "test:w": "npx vitest --config=vitest.node.config.ts --watch",
        "build": "tsc -b tsconfig.json && vite build",
        "typecheck": "tsc -b tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "@actdim/msgmesh": ">=1.12.0",
        "rxjs": ">=7.8.0"
    },
    "devDependencies": {
        "@actdim/msgmesh": ">=1.12.0",
        "@types/node": "^24.10.0",
        "prettier": "^3.5.3",
        "rxjs": "^7.8.2",
        "typescript": "^5.9.3",
        "vite": "^6.2.1",
        "vite-plugin-dts": "^4.5.4",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.0.9"
    }
}
